<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Student Registration Form</title>
    <link href="style.css" rel="stylesheet" type="text/css" />
  </head>
  <body>

    <h1>Student Registration Form</h1>

    <form>

      <label>Student Name</label><br>
      <input type="text" id="studentName"><br><br>

      <label>Email Address</label><br>
      <input type="text" id="studentEmail"><br><br>

      <label>Create Password</label><br>
      <input type="password" id="password"><br><br>

      <label>Select Your Grade</label><br>
      <input type="radio" id="grade9" name="grade" value="Grade 9">Grade 9<br>
      <input type="radio" id="grade10" name="grade" value="Grade 10">Grade 10<br><br>

      <label>Choose Your Favorite Subjects</label><br>
      <input type="checkbox" id="subject1" value="Science">Science<br>
      <input type="checkbox" id="subject2" value="Mathematics">Mathematics<br><br>

      <input type="submit" value="Register">

    </form>

  </body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HTML Table Example</title>
</head>
<body>

  <h1>📊 Student Marks Table</h1>
  <p>This table shows the names of students and their marks in different subjects.</p>

  <table border="1">
    <tr>
      <th>Name</th>
      <th>Math</th>
      <th>Science</th>
      <th>English</th>
    </tr>
    <tr>
      <td>Aarav</td>
      <td>85</td>
      <td>90</td>
      <td>88</td>
    </tr>
    <tr>
      <td>Sneha</td>
      <td>92</td>
      <td>87</td>
      <td>91</td>
    </tr>
    <tr>
      <td>Rahul</td>
      <td>78</td>
      <td>84</td>
      <td>80</td>
    </tr>
    <tr>
      <td>Priya</td>
      <td>95</td>
      <td>93</td>
      <td>89</td>
    </tr>
  </table>

</body>
</html>
